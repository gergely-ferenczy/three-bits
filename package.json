{
  "name": "three-bits",
  "description": "Utilities for Three.js",
  "version": "0.14.0",
  "type": "module",
  "author": "Gergely Ferenczy",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergely-ferenczy/three-bits.git"
  },
  "keywords": [
    "three",
    "three.js",
    "javascript",
    "typescript",
    "3d",
    "canvas",
    "helper",
    "utility"
  ],
  "scripts": {
    "build": "vite build && tsc --build ./lib --emitDeclarationOnly",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "release-it --config release-it.config.ts",
    "storybook:dev": "storybook dev -p 6006"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  },
  "exports": {
    "types": "./lib/dist/index.d.ts",
    "default": "./lib/dist/index.js"
  },
  "sideEffects": false,
  "files": [
    "./lib/dist"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.1",
    "conventional-commits-filter": "^6.0.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.4.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.0",
    "lint-staged": "^17.0.5",
    "prettier": "^3.5.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "release-it": "^21.1.0",
    "storybook": "^10.3.5",
    "storybook-dark-mode": "^5.0.0",
    "three": "^0.186.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.0.14",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "eslint-import-resolver-typescript": "^4.4.4"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
