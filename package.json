{
  "name": "three-bits",
  "description": "Utilities for Three.js",
  "version": "0.13.1",
  "type": "module",
  "author": "Gergely Ferenczy",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gergely-ferenczy/three-bits.git"
  },
  "keywords": [
    "three",
    "three.js",
    "javascript",
    "typescript",
    "3d",
    "canvas",
    "helper",
    "utility"
  ],
  "scripts": {
    "build": "vite build && tsc --build ./lib --emitDeclarationOnly",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --build --emitDeclarationOnly",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "release-it --config release-it.config.ts",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  },
  "exports": {
    "types": "./lib/dist/index.d.ts",
    "default": "./lib/dist/index.js"
  },
  "sideEffects": false,
  "files": [
    "./lib/dist"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/types": "^21.0.1",
    "@eslint/js": "^10.0.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@release-it/conventional-changelog": "^11.0.0",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitest/coverage-v8": "^4.0.18",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-storybook": "^10.4.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.5.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "release-it": "^20.0.1",
    "storybook": "^10.3.5",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.25.0",
    "vite": "^8.0.14",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "three": ">=0.128.0"
  },
  "dependencies": {
    "eslint-import-resolver-typescript": "^4.4.4"
  }
}
